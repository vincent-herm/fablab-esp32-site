---
import Layout from '../layouts/Layout.astro';

const ENDPOINT = 'https://n8n.opentek.fr/webhook/omaiah-atelier-attente-reponse';
const EMAIL = 'vincent@opentek.fr';
---

<Layout
  title="Une place s'est libérée"
  description="Confirmer ou refuser la place proposée à l'atelier découverte ESP32."
>
  <section class="py-20 hero-pattern border-b border-base-200/60">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-base-content/50 text-sm font-mono font-medium mb-3">// atelier découverte</p>
      <h1 class="text-4xl sm:text-5xl font-black mb-5">Une place s'est libérée</h1>
    </div>
  </section>

  <section class="py-12">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="bloc" class="rounded-xl border border-primary/30 bg-primary/5 p-6 sm:p-8 space-y-5" data-endpoint={ENDPOINT}>
        <p id="question" class="text-base-content/80 leading-relaxed"></p>
        <div id="boutons" class="flex flex-wrap items-center gap-4">
          <button id="confirmer" type="button" class="btn btn-primary">Oui, je prends la place</button>
          <button id="refuser" type="button" class="btn btn-ghost">Non, je ne suis plus disponible</button>
        </div>
        <p id="statut" role="status" aria-live="polite" class="text-sm text-base-content/70"></p>
      </div>
      <p class="mt-6 text-sm text-base-content/60">Un souci ? Écrivez à <a class="link" href={`mailto:${EMAIL}`}>{EMAIL}</a> ou appelez le <a class="link" href="tel:+33646246199">06 46 24 61 99</a>.</p>
    </div>
  </section>
</Layout>

<script>
  const bloc = document.getElementById('bloc');
  const question = document.getElementById('question');
  const boutons = document.getElementById('boutons');
  const statut = document.getElementById('statut');
  const t = new URLSearchParams(location.search).get('t') || '';

  if (bloc && question && boutons && statut) {
    if (!/^w\.\d+\.[0-9a-f]{24}$/.test(t)) {
      question.textContent = 'Ce lien n’est pas valide. Utilisez le lien reçu dans votre email.';
      boutons.style.display = 'none';
    } else {
      question.textContent = 'Une place vient de se libérer à l’atelier découverte ESP32 et elle vous est proposée. Vous avez 2 heures à partir de l’email pour confirmer : passé ce délai, elle est proposée à la personne suivante.';
      const envoyer = async (action: 'confirmer' | 'refuser') => {
        boutons.querySelectorAll('button').forEach((b) => ((b as HTMLButtonElement).disabled = true));
        statut.textContent = 'Un instant…';
        try {
          const r = await fetch(bloc.dataset.endpoint as string, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ t, action }),
          });
          const rep = await r.json().catch(() => null);
          if (rep && rep.ok && rep.kind === 'refuser') {
            statut.textContent = 'Merci de nous avoir prévenus : la place sera proposée à la personne suivante.';
            boutons.style.display = 'none';
          } else if (rep && rep.ok) {
            statut.textContent = rep.deja ? 'Votre place était déjà confirmée.' : 'C’est confirmé : votre place est réservée. Un email de confirmation vous est envoyé.';
            boutons.style.display = 'none';
          } else if (rep && rep.etat === 'depasse') {
            statut.textContent = 'Le délai de 2 heures est dépassé : la place a été proposée à quelqu’un d’autre. Vous pouvez vous remettre sur la liste d’attente sur la page de l’atelier.';
            boutons.style.display = 'none';
          } else if (rep && rep.etat === 'complet') {
            statut.textContent = 'La séance est de nouveau complète. Écrivez-moi pour que nous trouvions une solution.';
            boutons.style.display = 'none';
          } else {
            statut.textContent = (rep && rep.erreur) || 'Une erreur est survenue. Écrivez-moi à vincent@opentek.fr.';
            boutons.querySelectorAll('button').forEach((b) => ((b as HTMLButtonElement).disabled = false));
          }
        } catch {
          statut.textContent = 'Une erreur est survenue. Écrivez-moi à vincent@opentek.fr.';
          boutons.querySelectorAll('button').forEach((b) => ((b as HTMLButtonElement).disabled = false));
        }
      };
      document.getElementById('confirmer')?.addEventListener('click', () => envoyer('confirmer'));
      document.getElementById('refuser')?.addEventListener('click', () => envoyer('refuser'));
    }
  }
</script>
