---
import Layout from '../layouts/Layout.astro';
import AtelierCard from '../components/AtelierCard.astro';
import { siteUrl } from '../utils/url';

const ateliers = [
  {
    numero: 0,
    title: 'Initiation — Zéro câblage',
    description: '9 manipulations pour découvrir l\'ESP32 : REPL, LED, PWM, bouton, WiFi, serveur web. Rien à brancher.',
    href: siteUrl('/ateliers/initiation/'),
    level: 'debutant' as const,
    duration: '3h',
    tags: ['ESP32', 'MicroPython', 'WiFi', 'LED', 'Débutant'],
  },
  {
    numero: 1,
    title: 'LED RGB et NeoPixel',
    description: 'Anime un bandeau de LED RGB WS2812 : couleurs, défilement, arc-en-ciel et effets aléatoires.',
    href: siteUrl('/ateliers/neopixel/'),
    level: 'debutant' as const,
    duration: '3h',
    tags: ['ESP32', 'NeoPixel', 'WS2812', 'RGB', 'Animations'],
  },
  {
    numero: 2,
    title: 'Station météo',
    description: 'Mesure la température avec un DS18B20 et affiche les données sur un écran OLED SSD1306.',
    href: siteUrl('/ateliers/station-meteo/'),
    level: 'debutant' as const,
    duration: '3h',
    tags: ['ESP32', 'DS18B20', 'OLED', 'I2C', '1-Wire'],
  },
  {
    numero: 7,
    title: 'Badge RFID',
    description: 'Un lecteur RC522 identifie les badges. Contrôle d\'accès à 3 niveaux, enregistrés en mémoire sur la carte.',
    href: siteUrl('/ateliers/rfid/'),
    level: 'intermediaire' as const,
    duration: '3h',
    tags: ['ESP32', 'RFID', 'RC522', 'SPI', 'Sécurité'],
  },
];

const prochainsDates = [
  { date: 'Sam. 5 Avril 2026', atelier: 'Serveur web ESP32', places: 2 },
  { date: 'Sam. 19 Avril 2026', atelier: 'Animations NeoPixel', places: 4 },
  { date: 'Sam. 3 Mai 2026', atelier: 'Serveur web ESP32', places: 6 },
];
---

<Layout
  title="Apprends l'électronique en faisant"
  description="Fablab en Ardèche — Ateliers MicroPython et ESP32 pour débutants. Objets connectés, sons, écrans tactiles, robotique. 20 € / 3h, 6 personnes max."
>

  <!-- ══════ HERO ══════ -->
  <section class="relative min-h-[100dvh] flex items-center overflow-hidden">
    <div class="absolute inset-0 dot-grid" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-20 relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-20 items-center">

        <!-- Contenu -->
        <div>
          <div class="inline-flex items-center gap-2 bg-emerald-500/10 text-emerald-500 border border-emerald-500/15 rounded-full px-3.5 py-1 text-xs font-medium tracking-wide mb-10 animate-fade-in">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            Fablab en Ardèche
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[0.95] animate-fade-in animate-delay-1">
            Apprends l'électronique
            <span class="text-emerald-500 block mt-1">en faisant</span>
          </h1>

          <p class="text-lg md:text-xl text-base-content/40 leading-relaxed mt-6 max-w-[48ch] animate-fade-in animate-delay-2">
            Des choses qui s'allument, sonnent, réagissent — et commandent, régulent, contrôlent ton monde.
          </p>

          <p class="text-base text-base-content/55 leading-relaxed mt-4 max-w-[52ch] animate-fade-in animate-delay-2">
            Ateliers pratiques avec <strong class="text-base-content/80 font-semibold">ESP32</strong> et <strong class="text-base-content/80 font-semibold">MicroPython</strong>. Pas de prérequis, juste de la curiosité.
          </p>

          <div class="flex flex-wrap gap-3 mt-10 animate-fade-in animate-delay-3">
            <a href={siteUrl('/ateliers/')} class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white px-6 py-3 rounded-xl text-sm font-semibold transition-all duration-300 ease-out hover:-translate-y-px active:translate-y-0 active:scale-[0.98] shadow-lg shadow-emerald-600/20">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              Voir les ateliers
            </a>
            <a href={siteUrl('/cours/')} class="inline-flex items-center gap-2 border border-base-content/10 hover:border-base-content/20 hover:bg-base-content/5 px-6 py-3 rounded-xl text-sm font-medium transition-all duration-300 ease-out hover:-translate-y-px">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              Cours théoriques
            </a>
          </div>

          <!-- Stats -->
          <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3 sm:gap-x-6 sm:gap-y-2 mt-14 text-sm animate-fade-in animate-delay-4">
            <div class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-emerald-500/60" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/></svg>
              <span><strong class="text-base-content font-semibold">40+</strong> <span class="text-base-content/35">cartes ESP32</span></span>
            </div>
            <div class="hidden sm:block w-px h-3.5 bg-base-content/10"></div>
            <div class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-emerald-500/60" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
              <span><strong class="text-base-content font-semibold">6</strong> <span class="text-base-content/35">participants max</span></span>
            </div>
            <div class="hidden sm:block w-px h-3.5 bg-base-content/10"></div>
            <div class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-emerald-500/60" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z"/><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z"/></svg>
              <span><strong class="text-base-content font-semibold">20&nbsp;&euro;</strong> <span class="text-base-content/35">par atelier</span></span>
            </div>
            <div class="hidden sm:block w-px h-3.5 bg-base-content/10"></div>
            <div class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-emerald-500/60" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span><strong class="text-base-content font-semibold">100&nbsp;%</strong> <span class="text-base-content/35">pratique</span></span>
            </div>
          </div>
        </div>

        <!-- Terminal -->
        <div class="hidden lg:block animate-fade-in animate-delay-3">
          <div class="rounded-2xl bg-zinc-950 border border-zinc-800/60 overflow-hidden shadow-[0_25px_60px_-15px_rgba(0,0,0,0.35)]">
            <div class="flex items-center gap-2 px-4 py-3 border-b border-zinc-800/60">
              <div class="flex gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-zinc-700/80"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-zinc-700/80"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-zinc-700/80"></div>
              </div>
              <span class="ml-2 text-[11px] text-zinc-500 font-mono">main.py</span>
            </div>
            <pre class="p-5 text-[13px] font-mono leading-[1.7]"><code><span class="text-emerald-400">from</span> <span class="text-zinc-300">machine</span> <span class="text-emerald-400">import</span> <span class="text-zinc-300">Pin</span>
<span class="text-emerald-400">import</span> <span class="text-zinc-300">network</span><span class="text-zinc-500">,</span> <span class="text-zinc-300">socket</span>

<span class="text-zinc-600"># Crée un point d'accès WiFi</span>
<span class="text-zinc-100">ap</span> <span class="text-zinc-500">=</span> <span class="text-zinc-300">network</span><span class="text-zinc-500">.</span><span class="text-zinc-200">WLAN</span><span class="text-zinc-500">(</span><span class="text-zinc-300">network</span><span class="text-zinc-500">.</span><span class="text-zinc-300">AP_IF</span><span class="text-zinc-500">)</span>
<span class="text-zinc-100">ap</span><span class="text-zinc-500">.</span><span class="text-zinc-200">active</span><span class="text-zinc-500">(</span><span class="text-amber-300">True</span><span class="text-zinc-500">)</span>
<span class="text-zinc-100">ap</span><span class="text-zinc-500">.</span><span class="text-zinc-200">config</span><span class="text-zinc-500">(</span>
  <span class="text-zinc-400">essid</span><span class="text-zinc-500">=</span><span class="text-amber-200/80">'ESP32-Fablab'</span><span class="text-zinc-500">,</span>
  <span class="text-zinc-400">password</span><span class="text-zinc-500">=</span><span class="text-amber-200/80">'micropython'</span>
<span class="text-zinc-500">)</span>

<span class="text-zinc-100">led</span> <span class="text-zinc-500">=</span> <span class="text-zinc-200">Pin</span><span class="text-zinc-500">(</span><span class="text-amber-300">2</span><span class="text-zinc-500">,</span> <span class="text-zinc-300">Pin</span><span class="text-zinc-500">.</span><span class="text-zinc-300">OUT</span><span class="text-zinc-500">)</span>
<span class="text-emerald-400">print</span><span class="text-zinc-500">(</span><span class="text-amber-200/80">'Serveur prêt !'</span><span class="text-zinc-500">)</span></code></pre>
          </div>
        </div>

      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-base-100 to-transparent pointer-events-none"></div>
  </section>


  <!-- ══════ 3 PILIERS ══════ -->
  <section class="py-28 border-t border-base-content/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-14">
        <p class="text-emerald-500 text-xs font-mono font-medium tracking-widest uppercase mb-3">Plateforme</p>
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">Tout ce qu'il te faut pour démarrer</h2>
        <p class="text-base-content/45 mt-3 max-w-[55ch]">Du code au composant, du débutant au maker — un parcours structuré.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

        <!-- Ateliers pratiques — large, spans 2 cols -->
        <a href={siteUrl('/ateliers/')} class="md:col-span-2 group rounded-2xl border border-base-content/5 bg-base-content/[0.02] p-8 md:p-10 flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-12 transition-all duration-300 ease-out hover:border-emerald-500/20 hover:bg-emerald-500/[0.03] hover:-translate-y-px">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/10 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg>
          </div>
          <div class="flex-1">
            <h3 class="text-xl font-bold mb-2 group-hover:text-emerald-500 transition-colors duration-300">Ateliers pratiques</h3>
            <p class="text-base-content/50 leading-relaxed text-sm max-w-[55ch]">
              4 projets progressifs avec du vrai matériel. Code MicroPython téléchargeable, schémas de câblage, étape par étape.
            </p>
          </div>
          <div class="flex items-center gap-1.5 text-sm text-emerald-500 font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            Découvrir
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </div>
        </a>

        <!-- Cours théoriques -->
        <a href={siteUrl('/cours/')} class="group rounded-2xl border border-base-content/5 bg-base-content/[0.02] p-8 transition-all duration-300 ease-out hover:border-emerald-500/20 hover:bg-emerald-500/[0.03] hover:-translate-y-px">
          <div class="w-10 h-10 rounded-lg bg-base-content/5 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-base-content/50" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/></svg>
          </div>
          <h3 class="text-lg font-bold mb-2 group-hover:text-emerald-500 transition-colors duration-300">Cours théoriques</h3>
          <p class="text-base-content/50 leading-relaxed text-sm">
            Protocoles I2C/SPI/I2S, MicroPython vs Arduino, capteurs et actionneurs, IoT et réseau.
          </p>
        </a>

        <!-- Documentation -->
        <a href={siteUrl('/doc/')} class="group rounded-2xl border border-base-content/5 bg-base-content/[0.02] p-8 transition-all duration-300 ease-out hover:border-emerald-500/20 hover:bg-emerald-500/[0.03] hover:-translate-y-px">
          <div class="w-10 h-10 rounded-lg bg-base-content/5 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-base-content/50" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
          </div>
          <h3 class="text-lg font-bold mb-2 group-hover:text-emerald-500 transition-colors duration-300">Documentation</h3>
          <p class="text-base-content/50 leading-relaxed text-sm">
            Fiches de référence : ESP32, ESP32-S3, Pico 2W, M5Stack. Composants, brochages, librairies MicroPython.
          </p>
        </a>

      </div>
    </div>
  </section>


  <!-- ══════ ATELIERS ══════ -->
  <section class="py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-emerald-500 text-xs font-mono font-medium tracking-widest uppercase mb-3">Ateliers</p>
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">Projets à réaliser</h2>
        </div>
        <a href={siteUrl('/ateliers/')} class="hidden sm:flex items-center gap-1.5 text-sm text-base-content/40 hover:text-emerald-500 transition-colors duration-300">
          Tous les ateliers
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {ateliers.map(atelier => (
          <AtelierCard {...atelier} />
        ))}
      </div>

    </div>
  </section>


  <!-- ══════ PROCHAINS ATELIERS ══════ -->
  <section class="py-28 border-t border-base-content/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

        <div>
          <p class="text-emerald-500 text-xs font-mono font-medium tracking-widest uppercase mb-3">Agenda</p>
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-5">Prochains ateliers</h2>
          <p class="text-base-content/45 leading-relaxed mb-10 max-w-[50ch]">
            En présentiel en Ardèche. Petits groupes, matériel fourni, ambiance détendue.
          </p>

          <div class="space-y-3">
            {prochainsDates.map(session => (
              <div class="flex items-center justify-between rounded-xl border border-base-content/5 bg-base-content/[0.02] px-5 py-4 transition-all duration-300 hover:border-base-content/10">
                <div>
                  <div class="font-semibold text-sm">{session.atelier}</div>
                  <div class="text-xs text-base-content/35 mt-0.5">{session.date}</div>
                </div>
                <div class="flex items-center gap-3">
                  <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${session.places <= 2 ? 'bg-amber-500/10 text-amber-500 border border-amber-500/10' : 'bg-emerald-500/10 text-emerald-500 border border-emerald-500/10'}`}>
                    {session.places} place{session.places > 1 ? 's' : ''}
                  </span>
                  <a href={siteUrl('/a-propos/#inscription')} class="text-xs font-semibold text-emerald-500 hover:text-emerald-400 transition-colors">Réserver</a>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-2xl border border-base-content/5 bg-base-content/[0.02] p-8">
          <h3 class="text-lg font-bold mb-8">Comment ça se passe</h3>
          <div class="space-y-6">
            {[
              { step: '01', title: 'Réserve ta place', desc: 'Envoie un message pour réserver. Paiement sur place le jour J.' },
              { step: '02', title: 'Viens avec ta curiosité', desc: 'Tout le matériel est fourni. Pas besoin d\'expérience.' },
              { step: '03', title: 'On construit ensemble', desc: 'Câblage, code, tests — 3h pour créer un projet fonctionnel.' },
              { step: '04', title: 'Tu repars avec tout', desc: 'Le code sur GitHub, les schémas, et un projet qui marche chez toi.' },
            ].map(item => (
              <div class="flex gap-4">
                <span class="font-mono text-emerald-500/40 text-xs font-bold mt-0.5 flex-shrink-0 w-6">{item.step}</span>
                <div>
                  <div class="font-semibold text-sm">{item.title}</div>
                  <div class="text-sm text-base-content/45 mt-0.5">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>
          <div class="mt-8 pt-6 border-t border-base-content/5 flex items-center justify-between">
            <div>
              <div class="text-2xl font-extrabold tracking-tight">20&nbsp;&euro;</div>
              <div class="text-xs text-base-content/35 mt-0.5">par personne &middot; 3h &middot; matériel fourni</div>
            </div>
            <a href={siteUrl('/a-propos/')} class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white px-5 py-2.5 rounded-xl text-sm font-semibold transition-all duration-300 ease-out hover:-translate-y-px active:scale-[0.98]">
              En savoir plus
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ══════ LE FABLAB ══════ -->
  <section class="py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] gap-16 items-start">

        <div>
          <p class="text-emerald-500 text-xs font-mono font-medium tracking-widest uppercase mb-3">Le fablab</p>
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-6">Un espace, un ingénieur, une pédagogie</h2>
          <div class="space-y-4 text-base-content/50 leading-relaxed">
            <p>
              Ingénieur diplômé de l'ENIM et ancien professeur à l'Université de Lorraine (25 ans d'enseignement en électronique et génie électrique), Vincent anime ce fablab en Ardèche avec une conviction : <strong class="text-base-content/80 font-semibold">on apprend l'électronique en la faisant</strong>.
            </p>
            <p>
              Pas de cours magistraux. Des projets réels, du vrai matériel, et quelqu'un à côté pour expliquer quand ça ne marche pas.
            </p>
          </div>
          <a href={siteUrl('/a-propos/')} class="inline-flex items-center gap-1.5 mt-6 text-sm text-emerald-500 font-medium hover:text-emerald-400 transition-colors duration-300">
            En savoir plus sur le fablab
