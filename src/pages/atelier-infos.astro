---
import Layout from '../layouts/Layout.astro';

const ENDPOINT = 'https://n8n.opentek.fr/webhook/omaiah-fablab-consentement';
const EMAIL = 'vincent@opentek.fr';
---

<Layout
  title="Recevoir les infos du fablab"
  description="Confirmer ou retirer mon accord pour être prévenu·e des événements du fablab."
>
  <section class="py-20 hero-pattern border-b border-base-200/60">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-base-content/50 text-sm font-mono font-medium mb-3">// fablab</p>
      <h1 id="titre" class="text-4xl sm:text-5xl font-black mb-5">Mes préférences</h1>
    </div>
  </section>

  <section class="py-12">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="bloc" class="rounded-xl border border-primary/30 bg-primary/5 p-6 sm:p-8 space-y-5" data-endpoint={ENDPOINT}>
        <p id="question" class="text-base-content/80 leading-relaxed"></p>
        <div class="flex flex-wrap items-center gap-4">
          <button id="valider" type="button" class="btn btn-primary"></button>
        </div>
        <p id="statut" role="status" aria-live="polite" class="text-sm text-base-content/70"></p>
      </div>
      <p class="mt-6 text-sm text-base-content/60">Une question ? Écrivez à <a class="link" href={`mailto:${EMAIL}`}>{EMAIL}</a>. Voir la <a class="link" href="/legal/#confidentialite">politique de confidentialité</a>.</p>
    </div>
  </section>
</Layout>

<script>
  const bloc = document.getElementById('bloc');
  const titre = document.getElementById('titre');
  const question = document.getElementById('question');
  const bouton = document.getElementById('valider') as HTMLButtonElement | null;
  const statut = document.getElementById('statut');
  const t = new URLSearchParams(location.search).get('t') || '';
  const kind = t.split('.')[0];

  if (bloc && titre && question && bouton && statut) {
    if (kind === 'c') {
      titre.textContent = 'Confirmer mon accord';
      question.textContent = 'Vous avez demandé à être prévenu·e par email des prochains ateliers et événements du fablab. Confirmez-vous ? Nous ne vous écrirons qu’à ce sujet, et vous pourrez retirer votre accord à tout moment.';
      bouton.textContent = 'Oui, je confirme';
    } else if (kind === 'r') {
      titre.textContent = 'Retirer mon accord';
      question.textContent = 'Vous ne souhaitez plus être prévenu·e des événements du fablab. Vos éventuelles inscriptions à un atelier ne sont pas modifiées.';
      bouton.textContent = 'Ne plus recevoir d’informations';
    } else {
      question.textContent = 'Ce lien n’est pas valide. Utilisez le lien reçu dans votre email.';
      bouton.style.display = 'none';
    }
    if (kind === 'c' || kind === 'r') {
      bouton.addEventListener('click', async () => {
        bouton.disabled = true;
        statut.textContent = 'Un instant…';
        try {
          const r = await fetch(bloc.dataset.endpoint as string, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ t }),
          });
          const rep = await r.json().catch(() => null);
          if (rep && rep.ok) {
            statut.textContent = rep.kind === 'c'
              ? (rep.deja ? 'Votre accord était déjà enregistré. Merci !' : 'Merci, c’est enregistré. Un email de confirmation vous est envoyé.')
              : 'C’est noté : vous ne recevrez plus d’informations sur le fablab.';
            bouton.style.display = 'none';
          } else {
            statut.textContent = (rep && rep.erreur) || 'Une erreur est survenue. Écrivez-moi à vincent@opentek.fr.';
            bouton.disabled = false;
          }
        } catch {
          statut.textContent = 'Une erreur est survenue. Écrivez-moi à vincent@opentek.fr.';
          bouton.disabled = false;
        }
      });
    }
  }
</script>
