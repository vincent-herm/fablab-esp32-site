---
import Layout from '../layouts/Layout.astro';
import { siteUrl } from '../utils/url';

const ENDPOINT = 'https://n8n.opentek.fr/webhook/omaiah-atelier-inscription';
const PLACES = 'https://n8n.opentek.fr/webhook/omaiah-atelier-places';
const ATTENTE = 'https://n8n.opentek.fr/webhook/omaiah-atelier-attente';
const EMAIL = 'vincent@opentek.fr';
const seances = [
  { id: 16, jour: 'Mercredi 4 novembre', horaire: '14 h – 17 h' },
  { id: 17, jour: 'Mercredi 18 novembre', horaire: '14 h – 17 h' },
];
---

<Layout
  title="Atelier découverte de l'univers ESP32"
  description="Initiation à l'électronique numérique : contrôlez votre monde avec l'ESP32, une carte programmable à quelques euros. Deux mercredis au Polinno de Joyeuse, gratuit pour le lancement, 10 places par séance."
>
  <section class="py-16 hero-pattern border-b border-base-200/60">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-5 gap-10 items-center">
      <div class="md:col-span-3">
        <p class="text-primary text-xs font-bold uppercase tracking-widest mb-3">Électronique numérique · Atelier découverte</p>
        <h1 class="text-4xl sm:text-5xl font-black mb-3">Découvrez l'univers ESP32</h1>
        <p class="text-2xl font-serif italic font-bold text-warning mb-5">Contrôlez votre monde.</p>
        <p class="text-base-content/70 text-lg leading-relaxed">
          Initiation à l'électronique numérique avec l'ESP32, une carte programmable à quelques euros qui permet de <strong class="text-base-content">mesurer et de piloter le monde réel</strong> : capteurs, lumières, écrans, objets connectés, depuis son téléphone. Aucune connaissance requise, chacun avance à son rythme. Une séance ou les deux.
        </p>
        <p class="mt-6"><a href="#reserver" class="btn btn-primary">Réserver ma place</a></p>
      </div>
      <figure class="md:col-span-2">
        <img src={siteUrl('/atelier-decouverte-ecosysteme.jpg')} alt="Une carte électronique entourée d'un écosystème connecté : éolienne, arbres, ondes Wi-Fi" class="rounded-xl bg-white w-full" width="1198" height="799" loading="eager" />
        <figcaption class="text-xs text-base-content/50 mt-2">Illustration générée par IA</figcaption>
      </figure>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <h2 class="text-2xl font-black mb-5">Comment ça se passe</h2>
        <ul class="space-y-3 text-base-content/70 leading-relaxed list-disc pl-5">
          <li>Deux séances de 3 heures, au <a class="link" href="https://polinno.art/index.php/le-fablab/" target="_blank" rel="noopener">Polinno, FabLab de Joyeuse</a> (4 rue de Soulège, 07260 Joyeuse) : <strong>mercredi 4 novembre</strong> et <strong>mercredi 18 novembre</strong>, de 14 h à 17 h. On peut venir à l'une, à l'autre, ou aux deux.</li>
          <li>Chacun avance en autonomie, accompagné, à partir de supports fournis. Aucun prérequis, dès 15 ans.</li>
          <li>Les ordinateurs sont sur place. Vous pouvez aussi apporter le vôtre pour y installer ce qu'il faut (Windows, Mac ou Linux). Les tablettes ne conviennent pas.</li>
          <li>Une carte ESP32 est offerte pour continuer le travail chez soi, si vous le souhaitez.</li>
          <li><strong>10 places maximum</strong> par séance.</li>
        </ul>
        <h2 class="text-2xl font-black mt-10 mb-4">Tarif</h2>
        <p class="text-base-content/70 leading-relaxed">
          Les séances sont <strong>gratuites pour le lancement</strong>. Seule l'adhésion à l'association <a class="link font-semibold" href={siteUrl('/legal/#soleviah')}>SOLEVIAH</a> est demandée : <strong>20 €</strong>, valable un an, à régler sur place (une attestation vous est remise). Si vous êtes déjà adhérent·e, il n'y a rien à payer.
        </p>
      </div>

      <div id="reserver" class="rounded-xl border border-primary/30 bg-primary/5 p-6 sm:p-8 scroll-mt-24">
        <h2 class="text-2xl font-black mb-6">Réserver sa place</h2>
        <form id="form-atelier" class="space-y-5" novalidate data-endpoint={ENDPOINT} data-places={PLACES} data-attente={ATTENTE}>
          <fieldset class="space-y-3">
            <legend class="font-semibold text-sm mb-2">Quelle(s) séance(s) ?</legend>
            {seances.map((s) => (
              <label class="flex items-center gap-3 cursor-pointer" data-seance={s.id}>
                <input type="checkbox" name="seances" value={s.id} class="checkbox checkbox-primary" />
                <span>{s.jour}, {s.horaire} <span class="text-base-content/60 text-sm" data-restantes></span></span>
              </label>
            ))}
          </fieldset>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="form-control"><span class="text-sm font-semibold">Prénom</span>
              <input id="a-prenom" class="input input-bordered w-full" name="prenom" required autocomplete="given-name" /></label>
            <label class="form-control"><span class="text-sm font-semibold">Nom</span>
              <input id="a-nom" class="input input-bordered w-full" name="nom" required autocomplete="family-name" /></label>
            <label class="form-control"><span class="text-sm font-semibold">Email</span>
              <input id="a-email" class="input input-bordered w-full" name="email" type="email" required autocomplete="email" /></label>
            <label class="form-control"><span class="text-sm font-semibold">Téléphone <span class="font-normal text-base-content/60">(facultatif)</span></span>
              <input id="a-tel" class="input input-bordered w-full" name="telephone" type="tel" autocomplete="tel" /></label>
          </div>

          <!-- piège à robots : invisible pour une personne -->
          <div aria-hidden="true" style="position:absolute;left:-9999px;height:0;overflow:hidden">
            <label>Ne pas remplir <input name="website" tabindex="-1" autocomplete="off" /></label>
          </div>

          <div class="space-y-3 text-sm">
            <label class="flex items-start gap-3 cursor-pointer"><input type="checkbox" name="consentement" id="a-consentement" required class="checkbox checkbox-sm mt-0.5" /><span>J'accepte que mes coordonnées soient utilisées pour gérer mon inscription à l'atelier. Elles ne servent à rien d'autre.</span></label>
            <label class="flex items-start gap-3 cursor-pointer"><input type="checkbox" name="mineur" class="checkbox checkbox-sm mt-0.5" /><span>J'ai moins de 18 ans (une autorisation parentale écrite sera demandée).</span></label>
            <label class="flex items-start gap-3 cursor-pointer"><input type="checkbox" name="dejaAdherent" class="checkbox checkbox-sm mt-0.5" /><span>Je suis déjà adhérent·e de l'association SOLEVIAH.</span></label>
            <label class="flex items-start gap-3 cursor-pointer"><input type="checkbox" name="optinFablab" id="a-optin" class="checkbox checkbox-sm mt-0.5" /><span>(Facultatif) J'accepte d'être prévenu·e par email des prochains ateliers et événements du fablab. Je peux retirer mon accord à tout moment. Cela n'a aucun effet sur mon inscription.</span></label>
          </div>

          <div class="flex flex-wrap items-center gap-4">
            <button type="submit" id="atelier-envoi" class="btn btn-primary">Je réserve</button>
            <p id="atelier-statut" role="status" aria-live="polite" class="text-sm text-base-content/70"></p>
          </div>
        </form>
        <p class="mt-6 pt-4 border-t border-base-200/80 text-sm text-base-content/60">
          Une question, ou plus de place ? Écrivez à <a class="link" href={`mailto:${EMAIL}`}>{EMAIL}</a> ou appelez le <a class="link" href="tel:+33646246199">06 46 24 61 99</a>. Atelier proposé par l'association <a class="link" href={siteUrl('/legal/#soleviah')}>SOLEVIAH</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('form-atelier') as HTMLFormElement | null;
  const statut = document.getElementById('atelier-statut');
  const envoi = document.getElementById('atelier-envoi') as HTMLButtonElement | null;

  async function majPlaces() {
    if (!form) return;
    try {
      const r = await fetch(form.dataset.places as string);
      if (!r.ok) return;
      const data = await r.json();
      for (const s of data.seances as { id: number; restantes: number; complet: boolean }[]) {
        const label = form.querySelector(`label[data-seance="${s.id}"]`);
        const input = label?.querySelector('input') as HTMLInputElement | null;
        const txt = label?.querySelector('[data-restantes]');
        if (!label || !input || !txt) continue;
        input.disabled = false;
        const el = label as HTMLElement;
        const pleine = ['rounded-lg', 'border-2', 'border-warning', 'bg-warning/10', 'p-3'];
        if (s.complet) {
          el.dataset.complet = '1';
          el.classList.add(...pleine);
          txt.innerHTML = '<span class="badge badge-warning font-black mr-2">COMPLET</span><span class="font-semibold text-warning">cochez pour vous inscrire sur la liste d’attente</span>';
        } else {
          delete el.dataset.complet;
          el.classList.remove(...pleine);
          txt.textContent = `· ${s.restantes} place${s.restantes > 1 ? 's' : ''} restante${s.restantes > 1 ? 's' : ''}`;
        }
      }
    } catch {
      /* l’affichage des places est facultatif */
    }
  }
  majPlaces();

  function majBouton() {
    if (!form || !envoi) return;
    const cochees = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="seances"]:checked'));
    const pleines = cochees.filter((c) => (c.closest('label') as HTMLElement | null)?.dataset.complet === '1');
    envoi.textContent = cochees.length && pleines.length === cochees.length ? 'Me mettre sur la liste d’attente' : pleines.length ? 'Je réserve / liste d’attente' : 'Je réserve';
  }
  form?.addEventListener('change', majBouton);

  if (form && statut && envoi) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.querySelector('input[name="seances"]:checked')) {
        statut.textContent = 'Choisissez au moins une séance.';
        return;
      }
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const corps = {
        prenom: data.get('prenom'),
        nom: data.get('nom'),
        email: data.get('email'),
        telephone: data.get('telephone'),
        seances: data.getAll('seances').map(Number),
        mineur: data.get('mineur') === 'on',
        dejaAdherent: data.get('dejaAdherent') === 'on',
        consentement: data.get('consentement') === 'on',
        consentementTexte: document.getElementById('a-consentement')?.closest('label')?.textContent?.trim().replace(/\s+/g, ' '),
        optinFablab: data.get('optinFablab') === 'on',
        optinTexte: document.getElementById('a-optin')?.closest('label')?.textContent?.trim().replace(/\s+/g, ' '),
        website: data.get('website'),
        source: location.pathname,
      };
      envoi.disabled = true;
      statut.textContent = 'Envoi en cours…';
      const post = async (url: string, seances: number[]) => {
        const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...corps, seances }) });
        return r.json().catch(() => null);
      };
      try {
        const choisies = corps.seances as number[];
        const pleines = choisies.filter((id) => form.querySelector<HTMLElement>(`label[data-seance="${id}"]`)?.dataset.complet === '1');
        const libres = choisies.filter((id) => !pleines.includes(id));
        const messages: string[] = [];
        let echec: string | null = null;
        if (libres.length) {
          const rep = await post(form.dataset.endpoint as string, libres);
          if (rep && rep.ok && rep.deja) messages.push('Vous étiez déjà inscrit·e à cette séance.');
          else if (rep && rep.ok) messages.push('C’est réservé ! Un email de confirmation vous est envoyé (pensez à regarder vos courriers indésirables).');
          else if (rep && Array.isArray(rep.complet)) pleines.push(...rep.complet);
          else echec = (rep && rep.erreur) || 'erreur';
        }
        if (!echec && pleines.length) {
          const rep = await post(form.dataset.attente as string, pleines);
          if (rep && rep.ok) messages.push('Cette séance est complète : vous êtes sur la liste d’attente. Si une place se libère, vous recevrez un email et aurez 2 heures pour confirmer.');
          else echec = (rep && rep.erreur) || 'erreur';
        }
        if (echec) {
          statut.textContent = echec === 'erreur' ? 'Une erreur est survenue. Écrivez-moi à vincent@opentek.fr ou appelez le 06 46 24 61 99.' : echec;
        } else {
          form.reset();
          statut.textContent = messages.join(' ');
        }
      } catch {
        statut.textContent = 'Une erreur est survenue. Écrivez-moi à vincent@opentek.fr ou appelez le 06 46 24 61 99.';
      } finally {
        envoi.disabled = false;
        majPlaces();
      }
    });
  }
</script>
